        <div>
          <h3 class="font-display text-xl border-b-2 border-border-strong pb-1 mb-4">Prediction Markets</h3>
          <div class="space-y-0">
            {polymarket.map((m) => (
              <div class="py-3 border-b border-border">
                <p class="text-dim text-sm leading-snug">{m.q}</p>
                <p class="font-mono text-xs text-faint mt-1">
                  <span class={m.yes > 50 ? 'text-safe font-medium' : 'text-crimson font-medium'}>{m.yes}% Yes</span>
                  <span class="mx-2">·</span>
                  Vol: {m.vol}
                </p>
              </div>
            ))}
          </div>
          {oddMarkets.length > 0 && (
            <div class="mt-4">
              <h4 class="font-mono text-xs text-faint uppercase tracking-wider mb-2">kalshi · oddpool</h4>
              <div class="space-y-0">
                {oddMarkets.map((m) => (
                  <div class="py-2.5 border-b border-border">
                    <p class="text-dim text-sm leading-snug">{m.q}</p>
                    <p class="font-mono text-xs text-faint mt-1">
                      <span class={m.yes > 50 ? 'text-safe font-medium' : 'text-crimson font-medium'}>{m.yes}% Yes</span>
                      <span class="mx-2">·</span>
                      Vol: {m.vol}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    {/* EMERGING CATEGORIES */}
    <div class="animate-fade-up delay-4">
      <p class="font-mono text-xs text-spice uppercase tracking-[0.2em] mb-1">what is starting</p>
      <h3 class="font-display text-xl border-b-2 border-border-strong pb-1 mb-2">Emerging DeFi Categories</h3>
      <p class="font-mono text-xs text-faint mb-5">
        {emergingMeta.scanned.toLocaleString()} protocols · {emergingMeta.scored} categories scored ·
        ranked by momentum × breadth × room to grow, not by size
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {emerging.map((c, i) => (
          <div class="border border-border rounded-xl bg-surface p-5 flex flex-col gap-3">
            <div class="flex items-baseline justify-between gap-3">
              <div class="flex items-baseline gap-2 min-w-0">
                <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display text-base truncate">{c.name}</span>
              </div>
              <span class="font-mono text-lg text-spice shrink-0">{c.score.toFixed(1)}</span>
            </div>

            <div class="flex items-baseline gap-3 font-mono text-xs">
              <span class="text-faint">{c.tvl}</span>
              <span class={chgClass(c.mom)}>{chgStr(c.mom)} 7d</span>
              {c.new90 > 0 && (
                <span class="text-water">+{c.new90} new</span>
              )}
            </div>

            {/* breadth is the honest number — one protocol mooning vs the whole category moving */}
            <div>
              <div class="flex justify-between font-mono text-[10px] text-faint uppercase tracking-wider mb-1">
                <span>breadth</span>
                <span>{c.breadth}% of {c.protocols} up</span>
              </div>
              <div class="h-1.5 rounded-full bg-surface-2 overflow-hidden">
                <div class={`h-full rounded-full ${c.breadth >= 50 ? 'bg-safe' : c.breadth >= 30 ? 'bg-spice' : 'bg-faint'}`}
                     style={`width:${Math.max(c.breadth, 2)}%`}></div>
              </div>
            </div>

            <div class="font-mono text-[10px] text-faint flex justify-between gap-2 pt-1 border-t border-border">
              <span class="truncate">led by {c.leader}</span>
              <span class="shrink-0">{c.whale}% in one</span>
            </div>
          </div>
        ))}
      </div>
      <p class="font-mono text-[10px] text-faint mt-3">
        {emergingMeta.days < 8
          ? `acceleration needs 7d of history — ${8 - emergingMeta.days} more night${8 - emergingMeta.days === 1 ? '' : 's'}`
          : 'Δ7 shows whether a category is speeding up or rolling over'}
        · centralised exchanges excluded · categories under $100M excluded
      </p>
    </div>

    {/* OUTSIDE THE BUBBLE */}
    {discovery.length > 0 && (
      <div class="animate-fade-up delay-4">
        <p class="font-mono text-xs text-spice uppercase tracking-[0.2em] mb-1">who you are not following</p>
        <h3 class="font-display text-xl border-b-2 border-border-strong pb-1 mb-2">Outside the Bubble</h3>
        <p class="font-mono text-xs text-faint mb-5">
          searched all of X, every post id resolved against the API ·
          <span class="text-spice">{discoveryMeta.outside} of {discoveryMeta.verified}</span> from accounts
          your {discoveryMeta.followed}-account list does not follow
          {discoveryMeta.shown < discoveryMeta.verified && ` · showing top ${discoveryMeta.shown}`}
        </p>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
          {discovery.map((p, i) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer"
               class="group border border-border rounded-xl bg-surface p-4 flex flex-col gap-2
                      hover:border-border-strong hover:bg-surface-2 transition-colors">
              <div class="flex items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-2 min-w-0">
                  <span class="font-mono text-xs text-faint shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  {/* anchors inherit --color-accent, which paints the whole card orange.
                       Pin the ladder explicitly: handle > claim > meta. */}
                  <span class="font-display text-base truncate text-text group-hover:text-spice transition-colors">{p.handle}</span>
                  {p.outside && (
                    <span class="font-mono text-[10px] text-water uppercase tracking-wider shrink-0">new</span>
                  )}
                </div>
                <span class="font-mono text-xs text-faint shrink-0">{p.eng}</span>
              </div>
              <p class="text-sm leading-snug text-dim">{p.claim}</p>
              <div class="flex items-baseline justify-between gap-2 pt-2 border-t border-border font-mono text-[10px] text-faint">
                <span class="truncate uppercase tracking-wider">{p.sector}</span>
                <span class="shrink-0">{p.time}</span>
              </div>
            </a>
          ))}
        </div>
        <p class="font-mono text-[10px] text-faint mt-3">
          {discoveryMeta.dropped > 0
            ? `${discoveryMeta.dropped} cited post${discoveryMeta.dropped === 1 ? '' : 's'} failed to resolve and ${discoveryMeta.dropped === 1 ? 'was' : 'were'} dropped`
            : 'every cited post resolved'}
          · handle, engagement and timestamp come from the X API, never from the model
        </p>
      </div>
    )}

    {/* BOTTOM */}
    <div class="animate-fade-up delay-4">
      <p class="font-mono text-xs text-spice uppercase tracking-[0.2em] mb-1">on-chain flow</p>
      <h3 class="font-display text-xl border-b-2 border-border-strong pb-1 mb-6">DEX Activity & Trending Pools</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-border rounded-xl bg-surface p-5">
          <h4 class="font-mono text-xs text-faint uppercase tracking-wider mb-3">trending pools</h4>
          {trendingPools.map((p) => (
            <div class="py-2 border-b border-border last:border-b-0">
              <div class="font-display text-sm">{p.name}</div>
              <div class="font-mono text-xs text-faint">
                {p.network} · {p.vol} <span class={chgClass(p.change)}>{chgStr(p.change)}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="border border-border rounded-xl bg-surface p-5 md:col-span-2">
          <h4 class="font-mono text-xs text-faint uppercase tracking-wider mb-3">defi tvl — top 8</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
            {tvl.map((p) => (
              <div class="flex justify-between py-2 border-b border-border">
                <span class="font-display text-sm">{p.name}</span>
                <span class="font-mono text-xs text-faint">
                  {p.tvl} <span class={chgClass(p.change)}>{p.change >= 0 ? '+' : ''}{p.change}%</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="text-center font-mono text-xs text-faint tracking-wider uppercase border-t border-border pt-6">
      {date} · data from 12 sources · not financial advice
    </div>
  </div>
</Layout>
