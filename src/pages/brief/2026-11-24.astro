<Layout title="brief — Tuesday, November 24, 2026" description="12-source automated market intelligence briefing" wide>
  <div class="space-y-8">

    {/* MASTHEAD */}
    <div class="text-center animate-fade-up">
      <p class="font-mono text-xs tracking-[0.2em] text-faint uppercase">{date}</p>
