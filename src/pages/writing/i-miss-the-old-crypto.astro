---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="i miss the old crypto" description="the financial lego crypto. the new primitive every week crypto.">
  <div class="space-y-6">
    <div class="font-mono text-xs text-faint mb-4">
      <a href="/writing" class="text-accent hover:underline">writing</a> <span class="text-faint">/</span> i-miss-the-old-crypto
    </div>

    <h1 class="font-display text-3xl font-normal animate-fade-up">i miss the old crypto</h1>

    <div class="essay mt-10 animate-fade-up delay-1">
      <p>i miss the old crypto.</p>
      <p>the financial lego crypto.</p>
      <p>the new primitive every week crypto.</p>
      <hr class="my-12 border-border" />
      <p class="mt-6 text-spice">the “holy shit, this actually composes” crypto.</p>
    </div>

    <div class="mt-16 pt-6 border-t border-border">
      <a href="/writing" class="text-accent hover:underline">← back to writing</a>
    </div>
  </div>
</Layout>

<style>
  .essay p {
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }
</style>
