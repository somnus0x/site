---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="attention is the bottleneck" description="vibecoding flooded the market with software. it did not flood the market with users.">
  <div class="space-y-6">
    <div class="font-mono text-xs text-faint mb-4">
      <a href="/writing" class="text-accent hover:underline">writing</a> <span class="text-faint">/</span> attention-is-the-bottleneck
    </div>

    <h1 class="font-display text-3xl font-normal animate-fade-up">attention is the bottleneck</h1>

    <div class="essay mt-10 animate-fade-up delay-1">
      <p>vibecoding flooded the market with software.</p>
      <hr class="my-12 border-border" />
      <p>it didn’t flood the market with users.</p>
      <p class="mt-6 text-spice">attention is the new bottleneck.</p>
    </div>

    <div class="mt-16 pt-6 border-t border-border">
      <a href="/writing" class="text-accent hover:underline">← back to writing</a>
    </div>
  </div>
</Layout>

<style>
  .essay p {
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }
</style>
