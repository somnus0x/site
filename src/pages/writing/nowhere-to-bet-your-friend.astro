---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="nowhere to bet your friend" description="wanted to bet a friend he would show up to the gym. turns out there is nowhere to do that.">
  <div class="space-y-6">
    <div class="font-mono text-xs text-faint mb-4">
      <a href="/writing" class="text-accent hover:underline">writing</a> <span class="text-faint">/</span> nowhere-to-bet-your-friend
    </div>

    <h1 class="font-display text-3xl font-normal animate-fade-up">nowhere to bet your friend</h1>

    <div class="essay mt-10 animate-fade-up delay-1">
      <p>been wanting to bet my friend he’ll actually show up to the gym for a month.</p>
      <p>turns out there’s nowhere to do that.</p>
      <hr class="my-12 border-border" />
      <p>polymarket isn’t built for markets this small. everything else feels too serious.</p>
      <p>so where do the small and personal ones go?</p>
      <hr class="my-12 border-border" />
      <p>so i decided to build a place for them.</p>
      <p class="mt-6 text-spice">hot take.</p>
    </div>

    <div class="mt-16 pt-6 border-t border-border">
      <a href="/writing" class="text-accent hover:underline">← back to writing</a>
    </div>
  </div>
</Layout>

<style>
  .essay p {
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }
</style>
