---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="show the wow flow first" description="people are trained to swipe away at the first hint of discomfort.">
  <div class="space-y-6">
    <div class="font-mono text-xs text-faint mb-4">
      <a href="/writing" class="text-accent hover:underline">writing</a> <span class="text-faint">/</span> show-the-wow-flow-first
    </div>

    <h1 class="font-display text-3xl font-normal animate-fade-up">show the wow flow first</h1>

    <div class="essay mt-10 animate-fade-up delay-1">
      <p>one rule i always follow on a new app.</p>
      <p>make the user see the wow flow as fast as possible.</p>
      <hr class="my-12 border-border" />
      <p class="mt-6 text-spice">people are trained to swipe away at the first hint of discomfort.</p>
    </div>

    <div class="mt-16 pt-6 border-t border-border">
      <a href="/writing" class="text-accent hover:underline">← back to writing</a>
    </div>
  </div>
</Layout>

<style>
  .essay p {
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }
</style>
